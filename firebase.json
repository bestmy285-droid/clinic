{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": "clinic"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "node scripts/prepare-functions.js"
    ]
  }
}
